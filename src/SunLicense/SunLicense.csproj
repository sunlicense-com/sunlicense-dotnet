<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>SunLicense</PackageId>
    <Version>0.2.0</Version>
    <Authors>Hapangama</Authors>
    <Company>SunLicense</Company>
    <Title>SunLicense .NET Client</Title>
    <Description>Official SunLicense client for .NET — licence key management and validation for indie software developers, FiveM scripts and desktop applications.</Description>
    <PackageTags>license;licence;licensing;license-key;activation;drm;anti-piracy;fivem;sunlicense</PackageTags>
    <PackageProjectUrl>https://sunlicense.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sunlicense-com/sunlicense-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SunLicense.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
